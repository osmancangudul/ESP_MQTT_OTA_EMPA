# -------------------------------------------------------
# Project defaults — applied automatically by idf.py when
# sdkconfig is (re)generated (after fullclean / set-target).
# Commit this file; do NOT commit sdkconfig itself.
# -------------------------------------------------------

# Flash size — DevKit boards typically have 4 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Use the custom partition table that includes two OTA slots
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
